{
  "name": "sabor-y-fuego",
  "version": "1.0.0",
  "description": "Tienda de comidas y pedidos en linea",
  "main": "dist/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "setup": "npm run build",
    "build:less": "lessc public/less/style.less public/css/style.css --source-map",
    "watch:less": "less-watch-compiler public/less public/css style.less",
    "build:ts": "tsc",
    "build": "npm run build:less && npm run build:ts",
    "build:prod": "npm run lint && npm run type-check && npm run build",
    "dev": "concurrently \"npm run watch:less\" \"nodemon\"",
    "watch:ts": "tsc --watch",
    "watch": "concurrently \"npm run watch:less\" \"npm run watch:ts\"",
    "start": "node dist/index.js",
    "start:prod": "NODE_ENV=production node dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "validate": "npm run lint && npm run type-check && npm run format:check",
    "validate:fix": "npm run lint:fix && npm run format && npm run type-check",
    "clean": "rimraf dist && rimraf public/css/style.css public/css/style.css.map",
    "clean:all": "npm run clean && rimraf node_modules package-lock.json",
    "test": "echo \"Error: no test specified\" && exit 1",
    "docker:build": "docker build -t sabor-y-fuego:latest .",
    "docker:run": "docker run -p 3000:3000 -e NODE_ENV=production sabor-y-fuego:latest",
    "docker:compose:up": "docker-compose up --build",
    "docker:compose:down": "docker-compose down"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.6",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "less": "^4.2.0",
    "less-watch-compiler": "^1.16.3",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.10",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.18.2"
  }
}
