{
  "name": "sabor-y-fuego",
  "version": "1.0.0",
  "description": "Tienda de comidas y pedidos en linea",
  "main": "server.js",
  "scripts": {
    "build": "lessc less/style.less css/style.css --source-map",
    "watch": "less-watch-compiler less css style.less",
    "start": "node server.js",
    "dev": "concurrently \"npm run watch\" \"npm run start\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "less": "^4.2.0",
    "less-watch-compiler": "^1.16.3"
  },
  "dependencies": {
    "express": "^4.18.2"
  }
}
